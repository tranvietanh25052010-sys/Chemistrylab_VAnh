<!DOCTYPE html>
<html>
<head>
    <title>Enter Name - ChemLab</title>
    <style>
        body { font-family: Arial, sans-serif; background:#0f172a; color:white; display:flex; justify-content:center; align-items:center; min-height:100vh; margin:0; }
        .box { background:#1e293b; padding:32px; border-radius:12px; text-align:center; width:90%; max-width:420px; }
        h2 { margin-top:0; }
        input { padding:10px; width:85%; margin:16px 0; border-radius:8px; border:none; font-size:16px; }
        button { padding:10px 28px; background:#3b82f6; color:white; border:none; border-radius:8px; font-size:16px; cursor:pointer; }
        button:hover { background:#2563eb; }
    </style>
</head>
<body>
    <div class="box">
        <h2>👋 Welcome to ChemLab</h2>
        <p>Please enter your name to continue:</p>
        <form method="POST">
            <input type="text" name="name" placeholder="Type your name here..." required autocomplete="off">
            <br>
            <button type="submit">Enter Site</button>
        </form>
    </div>
</body>
</html>
